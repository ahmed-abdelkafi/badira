# Local secrets for `next dev` / `wrangler dev` (copy to .dev.vars — never commit).
NEXTJS_ENV=development
SITE_URL=http://localhost:3000
TRUST_PROXY=false
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOTP_ENCRYPTION_KEY=
# Web Push (npm run vapid)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@labadira.com
